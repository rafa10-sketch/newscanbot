# ============================================================
# PentestBot v2 — Environment Configuration
# Docker Compose reads this file automatically.
# NEVER commit this file to version control.
# ============================================================

# ── Public URLs ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api-domain
APP_URL=https://domain

# ── Cloudflare Tunnel ─────────────────────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=

# ── Gemini AI (Primary Engine) ────────────────────────────────
# Gemini 1.5 Pro digunakan sebagai PRIMARY analysis engine.
# Jika 429 / rate-limit / error → otomatis failover ke Groq.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_MAX_TOKENS=8192
GEMINI_TEMPERATURE=0.2
GEMINI_TIMEOUT=120

# ── Groq AI (Backup Engine) ───────────────────────────────────
# Comma-separated list of API keys for round-robin rotation.
# Each scan section picks the next key to spread load and avoid revokes.
GROQ_API_KEYS=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=4096
GROQ_TEMPERATURE=0.2

# ── Telegram (optional — leave empty for API-only mode) ──────
TELEGRAM_BOT_TOKEN=
ALLOWED_USER_IDS=

# ── API Configuration ────────────────────────────────────────
PENTESTBOT_API_TOKEN=
<<<<<<< Updated upstream
CORS_ORIGINS=
=======
CORS_ORIGINS=https://domain
>>>>>>> Stashed changes
ENGINE_PORT=8000
FRONTEND_PORT=3000

# ── Concurrency & Timeouts ───────────────────────────────────
MAX_CONCURRENT_SCANS=3
SCAN_TIMEOUT=14400
LOG_LEVEL=INFO

# ── Container Paths ──────────────────────────────────────────
PENTESTBOT_DATA_DIR=/app/data
PENTESTBOT_LOGS_DIR=/app/logs
PENTESTBOT_REPORTS_DIR=/app/reports
PENTESTBOT_WORK_DIR=/app/data/work
PENTESTBOT_DB_PATH=/app/data/pentestbot.db

# ── Scan Tuning ──────────────────────────────────────────────
SUBFINDER_THREADS=10
NAABU_PORTS=
NAABU_TOP_PORTS=1000
NAABU_RATE=1000
NMAP_FLAGS=-sV -sC
NMAP_TIMING=T4
HTTPX_THREADS=50
NUCLEI_SEVERITY=critical,high,medium
NUCLEI_RATE_LIMIT=150
NUCLEI_TEMPLATES=

# ── Tool Toggles ─────────────────────────────────────────────
# Set to 'true' or 'false' to enable/disable specific tools.
ENABLE_AMASS=false
ENABLE_GOBUSTER=true
ENABLE_DIRSEARCH=true
ENABLE_FINGERPRINT=true
ENABLE_NIKTO=false
ENABLE_WPSCAN=true
ENABLE_JOOMSCAN=true
ENABLE_S3SCANNER=true
S3SCANNER_TIMEOUT=240
ENABLE_SSLYZE=true
ENABLE_WEB_DISCOVERY=true
ENABLE_SQLMAP=true
ENABLE_DALFOX=true
DALFOX_TIMEOUT=600
DALFOX_REQUEST_TIMEOUT=10
DALFOX_WORKERS=10
DALFOX_MAX_TARGETS_PER_HOST=30
DALFOX_DEEP_SCAN=false 
